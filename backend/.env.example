# App
NODE_ENV=development
APP_ADDRESS=0.0.0.0
APP_PORT=4000

# Docker Compose reads these when it creates the Postgres volume.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
TZ=Europe/Moscow

# Local npm: localhost. Inside the backend container Compose overrides this.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass

# CORS — browser origin of the Next.js app
CORS_ORIGIN=http://localhost:3000

# GraphQL IDE (GraphiQL). Turn both off in production.
GRAPHQL_ENABLE_IDE=true
GRAPHQL_ENABLE_INTROSPECTION=true

# JWT. Replace before any shared or production deploy.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Optional. `npm run db:seed` creates this admin when both values are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
